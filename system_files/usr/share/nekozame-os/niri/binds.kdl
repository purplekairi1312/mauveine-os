// nekozame os shortcuts (nekozame-mac has the same on a Mac, with Cmd as Super and
// Ctrl+Option as Ctrl+Alt). this replaces dankmaterialshell's binds file.
//   Super      apps, like Cmd on a Mac: Super+C/V/X copy, paste, cut, and the
//              rest of the usual app keys (xremap turns them into what each
//              app expects), plus launching things
//   Ctrl+Alt   windows: focus, move, size, workspaces
binds {
    // === Apps (Super) ===
    Super+Return hotkey-overlay-title="Terminal" { spawn "ghostty"; }
    Super+T hotkey-overlay-title="Terminal" { spawn "ghostty"; }
    Super+Space hotkey-overlay-title="Launcher" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Super+E hotkey-overlay-title="Files" { spawn "thunar"; }
    Super+Shift+E hotkey-overlay-title="Files in the terminal" { spawn "ghostty" "-e" "yazi"; }
    Super+B hotkey-overlay-title="Browser" { spawn "flatpak" "run" "app.zen_browser.zen"; }
    Super+Q repeat=false hotkey-overlay-title="Close" { close-window; }
    Super+Shift+V hotkey-overlay-title="Clipboard history" { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Super+Shift+Slash hotkey-overlay-title="Keyboard shortcuts" { spawn "dms" "ipc" "call" "keybinds" "toggle" "niri"; }
    Super+Comma hotkey-overlay-title="Settings" { spawn "dms" "ipc" "call" "settings" "focusOrToggle"; }
    Super+Tab hotkey-overlay-title="Previous window" { focus-window-previous; }
    // the shell's panels
    Super+D hotkey-overlay-title="Dash" { spawn "dms" "ipc" "call" "dash" "toggle" ""; }
    Super+Shift+A hotkey-overlay-title="Control center" { spawn "dms" "ipc" "call" "control-center" "toggle"; }
    Super+Shift+N hotkey-overlay-title="Notifications" { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Super+Shift+M hotkey-overlay-title="Media" { spawn "dms" "ipc" "call" "dash" "toggle" "media"; }
    Super+Y hotkey-overlay-title="Wallpapers" { spawn "dms" "ipc" "call" "dash" "toggle" "wallpaper"; }
    Super+Shift+C hotkey-overlay-title="Color picker" { spawn "dms" "ipc" "call" "color-picker" "toggle"; }
    Super+Alt+T hotkey-overlay-title="Notepad" { spawn "dms" "ipc" "call" "notepad" "toggle"; }
    Super+Alt+N hotkey-overlay-title="Night mode" { spawn "dms" "ipc" "call" "night" "toggle"; }
    Super+Alt+I hotkey-overlay-title="Keep awake" { spawn "dms" "ipc" "call" "inhibit" "toggle"; }
    // like a Mac: lock, log out, force quit (the task manager)
    Ctrl+Super+Q hotkey-overlay-title="Lock" { spawn "dms" "ipc" "call" "lock" "lock"; }
    Super+Shift+Q hotkey-overlay-title="Log out" { quit; }
    Super+Alt+Escape hotkey-overlay-title="Task manager" { spawn "dms" "ipc" "call" "processlist" "focusOrToggle"; }
    Ctrl+Alt+Delete hotkey-overlay-title="Power menu" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    // let a VM or remote desktop have all the keys (press again to get them back)
    Super+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    // screenshots: Print, or like a Mac (Super+Shift+3 screen, 4 region, 5 window)
    Print hotkey-overlay-title="Screenshot: region" { spawn "dms" "screenshot"; }
    Ctrl+Print { spawn "dms" "screenshot" "full"; }
    Alt+Print { spawn "dms" "screenshot" "window"; }
    Super+Shift+3 hotkey-overlay-title="Screenshot: screen" { spawn "dms" "screenshot" "full"; }
    Super+Shift+4 hotkey-overlay-title="Screenshot: region" { spawn "dms" "screenshot"; }
    Super+Shift+5 hotkey-overlay-title="Screenshot: window" { spawn "dms" "screenshot" "window"; }

    // === Windows (Ctrl+Alt) ===
    Ctrl+Alt+Left  { focus-column-left; }
    Ctrl+Alt+Right { focus-column-right; }
    Ctrl+Alt+Up    { focus-window-up; }
    Ctrl+Alt+Down  { focus-window-down; }
    Ctrl+Alt+Shift+Left  { move-column-left; }
    Ctrl+Alt+Shift+Right { move-column-right; }
    Ctrl+Alt+Shift+Up    { move-window-up; }
    Ctrl+Alt+Shift+Down  { move-window-down; }
    Ctrl+Alt+Home { focus-column-first; }
    Ctrl+Alt+End  { focus-column-last; }
    Ctrl+Alt+Shift+Home { move-column-to-first; }
    Ctrl+Alt+Shift+End  { move-column-to-last; }
    Ctrl+Alt+Return       hotkey-overlay-title="Maximize" { maximize-column; }
    Ctrl+Alt+Shift+Return hotkey-overlay-title="Fullscreen" { fullscreen-window; }
    Ctrl+Alt+R       { switch-preset-column-width; }
    Ctrl+Alt+Shift+R { switch-preset-window-height; }
    Ctrl+Alt+Minus       { set-column-width "-10%"; }
    Ctrl+Alt+Equal       { set-column-width "+10%"; }
    Ctrl+Alt+Shift+Minus { set-window-height "-10%"; }
    Ctrl+Alt+Shift+Equal { set-window-height "+10%"; }
    Ctrl+Alt+C { center-column; }
    Ctrl+Alt+BracketLeft  { consume-or-expel-window-left; }
    Ctrl+Alt+BracketRight { consume-or-expel-window-right; }
    Ctrl+Alt+W { toggle-column-tabbed-display; }
    Ctrl+Alt+Space       hotkey-overlay-title="Float" { toggle-window-floating; }
    Ctrl+Alt+Shift+Space { switch-focus-between-floating-and-tiling; }
    Ctrl+Alt+O hotkey-overlay-title="Overview" { toggle-overview; }
    // workspaces
    Ctrl+Alt+Page_Down { focus-workspace-down; }
    Ctrl+Alt+Page_Up   { focus-workspace-up; }
    Ctrl+Alt+Shift+Page_Down { move-column-to-workspace-down; }
    Ctrl+Alt+Shift+Page_Up   { move-column-to-workspace-up; }
    // Alt+number: workspace 1-9 (Shift takes the window along)
    Alt+1 { focus-workspace 1; }
    Alt+2 { focus-workspace 2; }
    Alt+3 { focus-workspace 3; }
    Alt+4 { focus-workspace 4; }
    Alt+5 { focus-workspace 5; }
    Alt+6 { focus-workspace 6; }
    Alt+7 { focus-workspace 7; }
    Alt+8 { focus-workspace 8; }
    Alt+9 { focus-workspace 9; }
    Alt+Shift+1 { move-column-to-workspace 1; }
    Alt+Shift+2 { move-column-to-workspace 2; }
    Alt+Shift+3 { move-column-to-workspace 3; }
    Alt+Shift+4 { move-column-to-workspace 4; }
    Alt+Shift+5 { move-column-to-workspace 5; }
    Alt+Shift+6 { move-column-to-workspace 6; }
    Alt+Shift+7 { move-column-to-workspace 7; }
    Alt+Shift+8 { move-column-to-workspace 8; }
    Alt+Shift+9 { move-column-to-workspace 9; }
    Ctrl+Alt+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Ctrl+Alt+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    // monitors: add Super
    Ctrl+Alt+Super+Left  { focus-monitor-left; }
    Ctrl+Alt+Super+Right { focus-monitor-right; }
    Ctrl+Alt+Super+Up    { focus-monitor-up; }
    Ctrl+Alt+Super+Down  { focus-monitor-down; }
    Ctrl+Alt+Super+Shift+Left  { move-column-to-monitor-left; }
    Ctrl+Alt+Super+Shift+Right { move-column-to-monitor-right; }
    Ctrl+Alt+Super+Shift+Up    { move-column-to-monitor-up; }
    Ctrl+Alt+Super+Shift+Down  { move-column-to-monitor-down; }

    // === Audio Controls ===
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "increment" "3";
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "decrement" "3";
    }
    XF86AudioMute allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "mute";
    }
    XF86AudioMicMute allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "micmute";
    }
    XF86AudioPause allow-when-locked=true {
        spawn "dms" "ipc" "call" "mpris" "playPause";
    }
    XF86AudioPlay allow-when-locked=true {
        spawn "dms" "ipc" "call" "mpris" "playPause";
    }
    XF86AudioPrev allow-when-locked=true {
        spawn "dms" "ipc" "call" "mpris" "previous";
    }
    XF86AudioNext allow-when-locked=true {
        spawn "dms" "ipc" "call" "mpris" "next";
    }
    Ctrl+XF86AudioRaiseVolume allow-when-locked=true {
        spawn "dms" "ipc" "call" "mpris" "increment" "3";
    }
    Ctrl+XF86AudioLowerVolume allow-when-locked=true {
        spawn "dms" "ipc" "call" "mpris" "decrement" "3";
    }

    // === Brightness Controls ===
    XF86MonBrightnessUp allow-when-locked=true {
       spawn "dms" "ipc" "call" "brightness" "increment" "5" "";
    }
    XF86MonBrightnessDown allow-when-locked=true {
       spawn "dms" "ipc" "call" "brightness" "decrement" "5" "";
    }

    // === Input ===
    XF86TouchpadToggle allow-when-locked=true repeat=false {
        spawn "niri" "msg" "action" "toggle-touchpad";
    }
    XF86TouchpadOn allow-when-locked=true repeat=false {
        spawn "dms" "ipc" "call" "niri" "showTouchpadOsd" "true";
    }
    XF86TouchpadOff allow-when-locked=true repeat=false {
        spawn "dms" "ipc" "call" "niri" "showTouchpadOsd" "false";
    }
}
