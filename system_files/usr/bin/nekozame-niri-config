#!/bin/bash
# first niri login, before niri starts: dankmaterialshell's niri config instead of
# niri's stock one (waybar, alacritty), plus the one-time nekozame dms defaults
set -euo pipefail
dms setup headless --compositor niri --no-systemd
# nekozame's shortcuts instead of dms's (Super for apps, Ctrl+Alt for windows)
sed -i 's|^include optional=true "dms/binds.kdl"|include "/usr/share/nekozame-os/niri/binds.kdl"  // nekozame shortcuts (was dms/binds.kdl)|' \
    "${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl"
cat >> "${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl" <<'KDL'

// nekozame os: theme + wallpaper in dms, once (nekozame-dms-defaults)
spawn-at-startup "nekozame-dms-defaults"
KDL
