#!/bin/bash
# one-time music setup for your user:
#   realtime priority for audio apps (realtime + audio groups, needs sudo)
#   bitwig studio from flathub, plus free plugins built for its runtime
#   yabridge pointed at its system copy, so windows plugins can be bridged
set -euo pipefail
sudo usermod -aG realtime,audio "$USER"

RUNTIME=25.08   # bitwig's flatpak runtime; its plugins must match it
flatpak install -y --user flathub com.bitwig.BitwigStudio
for p in Dexed Cardinal Helm Geonkick Calf x42Plugins ZamPlugins DragonflyReverb; do
    flatpak install -y --user flathub "org.freedesktop.LinuxAudio.Plugins.$p//$RUNTIME" || true
done

yabridgectl set --path=/usr/lib/yabridge
# where windows plugin installers put things inside wine
C="${WINEPREFIX:-$HOME/.wine}/drive_c/Program Files"
mkdir -p "$C/Common Files/VST3" "$C/Common Files/CLAP" "$C/VstPlugins"
for d in "$C/Common Files/VST3" "$C/Common Files/CLAP" "$C/VstPlugins"; do
    yabridgectl add "$d" 2>/dev/null || true
done
echo "done. log out and back in for realtime priority."
echo "windows plugins: install them with wine, then run: yabridgectl sync"
