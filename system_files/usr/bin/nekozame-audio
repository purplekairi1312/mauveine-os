#!/bin/bash
# nekozame-audio [low|normal|status]: audio latency for your user.
#   low (the default for everyone): 256-sample buffers, down to 32 when an app asks
#   normal: 1024-sample buffers, for hardware that crackles at low latency
# realtime priority and threadirqs are on for everyone in the image already.
set -euo pipefail
F="${XDG_CONFIG_HOME:-$HOME/.config}/pipewire/pipewire.conf.d/60-nekozame-latency.conf"
case "${1:-status}" in
    low) rm -f "$F" ;;
    normal)
        mkdir -p "$(dirname "$F")"
        cat > "$F" <<'CONF'
# nekozame-audio normal: bigger buffers (nekozame-audio low goes back)
context.properties = {
    default.clock.quantum     = 1024
    default.clock.min-quantum = 256
}
CONF
        ;;
    status)
        if [ -e "$F" ]; then echo "latency: normal"; else echo "latency: low"; fi
        echo "realtime priority: $(ulimit -r)"
        exit 0 ;;
    *) echo "usage: nekozame-audio [low|normal|status]" >&2; exit 2 ;;
esac
systemctl --user restart pipewire pipewire-pulse wireplumber
echo "latency: $1"
