#!/bin/bash
# fastfetch with the nekozame logo and colours: the logo image where the terminal
# can show images (kitty graphics: ghostty, kitty), a text one everywhere else
# (the tty, most ssh clients). the image is tied to placeholder text (kitty-logo),
# so inside tmux it stays with its tab and comes back when you switch back.
# your own logo: NEKOZAME_FETCH_LOGO (a png) and NEKOZAME_FETCH_WIDTH (columns)
D=/usr/share/nekozame-os/fastfetch
PINK="38;2;255;192;229"
args=(-c "$D/config.jsonc")
if [ "${TERM:-}" = linux ]; then
    # the text console only has its 16 colours (nekozame's, set at boot)
    args+=(--logo-type file-raw --logo "$D/logo-tty.txt" --logo-width 34 --logo-height 16 --color magenta)
elif term="${TERM:-}"; [ -n "${TMUX:-}" ] && term=$(tmux display -p '#{client_termname}' 2>/dev/null)
     [[ "$term" == *ghostty* || "$term" == *kitty* || -n "${KITTY_WINDOW_ID:-}" ]] \
     && l=($(kitty-logo "${NEKOZAME_FETCH_LOGO:-$D/logo.png}" "${NEKOZAME_FETCH_WIDTH:-30}" 2>/dev/null)); then
    args+=(--logo-type file-raw --logo "${l[0]}" --logo-width "${l[1]}" --logo-height "${l[2]}" --color "$PINK")
else
    args+=(--logo-type file-raw --logo "$D/logo-color.txt" --logo-width 34 --logo-height 16 --color "$PINK")
fi
exec /usr/bin/fastfetch "${args[@]}" "$@"
